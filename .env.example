# ==========================================
# MODÈLE du fichier .env — à copier en .env et à remplir
# avec vos vraies valeurs (ce fichier-ci n'en contient pas,
# il peut donc être partagé/publié sans risque).
#
# Comment l'utiliser :
#   1. Copiez ce fichier et renommez la copie ".env"
#   2. Remplacez les valeurs ci-dessous par les vôtres
# ==========================================
DB_UTILISATEUR=root
DB_MOT_DE_PASSE=votre_mot_de_passe
DB_HOTE=localhost
DB_PORT=3306
DB_NOM_BASE=maison_elite
